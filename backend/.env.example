# ==============================================================================
# SmartRoute Backend — Environment Variables Template
# Copy this file to .env in this directory or inject into Render / Docker
# NEVER commit real credentials or production secrets to Git!
# ==============================================================================

# Active Spring Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render sets this dynamically)
PORT=8080

# ------------------------------------------------------------------------------
# Database Configuration (Aiven MySQL 8.4)
# ------------------------------------------------------------------------------
# For Aiven MySQL, append sslMode=REQUIRED (or useSSL=true)
DB_URL=jdbc:mysql://<aiven-host>:<port>/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=<aiven-username>
DB_PASSWORD=<aiven-password>

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# Base64-encoded or raw 256-bit string (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-256-bit-jwt-secret-min-32-chars-long-here
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://smart-route-jet.vercel.app

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Gmail App Password)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-google-app-password
MAIL_FROM=noreply@anuraguniversity.edu.in

# Set to false to disable mandatory OTP for local registration testing
REQUIRE_EMAIL_VERIFICATION=false

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Optional SSO)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay sandbox/live)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay
PAYMENT_PROVIDER_KEY=rzp_test_placeholder
PAYMENT_PROVIDER_SECRET=your-razorpay-secret
PAYMENT_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ------------------------------------------------------------------------------
# Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
PUSH_VAPID_SUBJECT=mailto:admin@anuraguniversity.edu.in
PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key

# ------------------------------------------------------------------------------
# OCR & LLM Services (Optional)
# ------------------------------------------------------------------------------
OCR_ENABLED=false
OCR_API_KEY=
OCR_ENDPOINT=

LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4
LLM_ENDPOINT=
