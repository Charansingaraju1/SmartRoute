# SmartRoute Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials

# ===========================================
# Database
# ===========================================
DB_URL=jdbc:mysql://localhost:3306/smartroute?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=smartroute
DB_PASSWORD=your_strong_password_here

# ===========================================
# JWT Configuration
# ===========================================
# Generate a secure 256-bit (32+ character) secret for production
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars-change-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed frontend origins or patterns (e.g. https://*.vercel.app,https://yourdomain.com)
# Defaults to local Vite development origins if omitted
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===========================================
# OAuth / Google Single Sign-On (SSO)
# ===========================================
# Google Cloud Console OAuth 2.0 Web Client ID
# Create at: https://console.cloud.google.com/apis/credentials
# Leave empty to keep Google SSO safely disabled.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===========================================
# Email Configuration (SMTP)
# ===========================================
# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords (Select App: Mail, Device: Other)
# 3. Enter your full Gmail address in MAIL_USERNAME and MAIL_FROM
# 4. Enter the 16-character App Password (without spaces) in MAIL_PASSWORD
# NOTE: A normal Google account password will NOT work with Gmail SMTP.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-actual-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM=your-actual-email@gmail.com

# For local development with MailHog/Mailpit (no credentials required):
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@anuraguniversity.edu.in

# ===========================================
# OTP Configuration
# ===========================================
# Set to false to disable email OTP verification during registration (recommended for local development when SMTP is unconfigured)
REQUIRE_EMAIL_VERIFICATION=false
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=5

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_PASSWORD_RESET_MAX_ATTEMPTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_MINUTES=60

# ===========================================
# Payment Gateway (Razorpay example)
# ===========================================
PAYMENT_PROVIDER=razorpay
PAYMENT_PROVIDER_KEY=rzp_test_xxxxxxxxxxxx
PAYMENT_PROVIDER_SECRET=your-secret-key
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# ===========================================
# Web Push (VAPID Keys)
# ===========================================
# Generate with: npx web-push generate-vapid-keys
PUSH_VAPID_SUBJECT=mailto:admin@anuraguniversity.edu.in
PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key

# ===========================================
# OCR Service (Optional)
# ===========================================
OCR_ENABLED=false
OCR_API_KEY=
OCR_ENDPOINT=

# ===========================================
# LLM Service (Optional)
# ===========================================
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4
LLM_ENDPOINT=

# ===========================================
# Transport Workbook
# ===========================================
TRANSPORT_WORKBOOK_PATH=classpath:data/AU_College_Transport_2026-2027-1.xls

# ===========================================
# Frontend (Vite)
# ===========================================
VITE_API_URL=http://localhost:8080/api