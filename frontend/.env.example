# SmartRoute Frontend Environment Variables
# Copy to .env.local for local overrides or configure in Vercel project settings

# Backend API base URL
# Local development uses Vite proxy to http://localhost:8080/api by default
# For production/preview deployment on Vercel, set this to your backend domain:
# IMPORTANT: Must include the Spring Boot context path `/api`
# Example: VITE_API_URL=https://your-backend-service.com/api
VITE_API_URL=/api

# Google OAuth 2.0 Web Client ID
# Must match the backend GOOGLE_CLIENT_ID configuration.
# Leave empty to keep Google SSO safely disabled.
# Example: VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

